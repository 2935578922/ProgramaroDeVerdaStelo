<style>
    .cssController {
        transition: fill 100ms ease-out;
    }

    .btn2 {
        transition:opacity 200ms ease, background-color 100ms ease-out;
        padding:0px 0px 0px 0px;
        cursor:pointer;
        color:#B5DDD2; /*#008066*/
        background-color:#68B9A2;
        border:none;
    }
    .btn2:hover {
        background-color:#ffffff;
    }

    #svg1 {
        transition:transform 200ms ease;
        transform-origin:center center;
    }
    @@keyframes start-animation1 {
        from {
            opacity:0;
            transform:translateY(-3vh);
        }
        to {
            opacity:1;
            transform:translateY(0);
        }
    } 
</style>

@code {
    [Parameter]
    public string Style {get;set;}="";

    [Parameter]
    public string Style1 {get;set;}="";

    string SoftdiskBorderColor="#46AB8E";
    string SoftdiskBottomColor="#68B9A2";
    string SoftdiskScale="1";
    
    bool IfFinishAnimation=true;

    void f()
    {
        SoftdiskBorderColor="#68B9A2";
        SoftdiskBottomColor="#46AB8E";
    }
    void f1()
    {
        SoftdiskBorderColor="#46AB8E";
        SoftdiskBottomColor="#68B9A2";
    }
    async Task f2()
    {
        if(IfFinishAnimation)
        {
            IfFinishAnimation=false;
            SoftdiskScale="0.8";
            await Task.Delay(200);
            SoftdiskScale="1";
            IfFinishAnimation=true;
        }
    }
}